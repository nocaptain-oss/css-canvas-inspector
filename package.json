{
  "name": "css-canvas-inspector",
  "version": "0.3.11",
  "description": "A lightweight visual CSS inspector for human-agent collaboration on fixed-size HTML canvases.",
  "type": "module",
  "license": "MIT",
  "files": [
    "index.html",
    "blank.html",
    "demo.html",
    "src",
    "skills",
    "README.md",
    "LICENSE",
    "AGENTS.md",
    "INTEGRATION.md",
    "INTEGRATION.zh.md"
  ],
  "scripts": {
    "sync:skill": "node scripts/sync-skill-runtime.mjs",
    "check:skill": "node scripts/sync-skill-runtime.mjs --check",
    "check": "node --check src/inspector.js && npm run check:skill",
    "test": "node --test tests/canvas-size.test.mjs && python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "keywords": [
    "css",
    "visual-editor",
    "design-tool",
    "html",
    "agent"
  ]
}
